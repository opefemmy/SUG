datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  email_verified_at DateTime?
  password          String
  status            String    @default("active")
  remember_token    String?
  created_at        DateTime  @default(now())
  updated_at        DateTime @updatedAt
  sessions          Session[]
  students          Student[]
  support_tickets   SupportTicket[] @relation("assigned_to")
  support_messages   SupportMessage[]
  election_audit_logs ElectionAuditLog[]

  @@map("users")
}

model Session {
  id            String  @id
  user_id       Int?
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int
  user          User?   @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([last_activity])
  @@map("sessions")
}

model PasswordResetToken {
  email      String    @id
  token      String
  created_at DateTime?

  @@map("password_reset_tokens")
}

model School {
  id        Int          @id @default(autoincrement())
  name      String
  code      String       @unique
  slug      String       @unique
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  departments Department[]
  students    Student[]

  @@map("schools")
}

model Department {
  id        Int         @id @default(autoincrement())
  school_id Int
  name      String
  code      String      @unique
  slug      String      @unique
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  school    School      @relation(fields: [school_id], references: [id], onDelete: Cascade)
  programmes Programme[]
  students    Student[]

  @@map("departments")
}

model Programme {
  id              Int         @id @default(autoincrement())
  department_id   Int
  name            String
  code            String      @unique
  duration_years  Int
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  department     Department  @relation(fields: [department_id], references: [id], onDelete: Cascade)
  levels          Level[]
  students        Student[]
  fee_structures FeeStructure[]

  @@map("programmes")
}

model Level {
  id            Int       @id @default(autoincrement())
  programme_id  Int?
  level_number  String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  programme    Programme? @relation(fields: [programme_id], references: [id], onDelete: Cascade)
  students      Student[]
  fee_structures FeeStructure[]

  @@map("levels")
}

model AcademicSession {
  id           Int       @id @default(autoincrement())
  session_name String
  is_current   Boolean   @default(false)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  students     Student[]
  fee_structures FeeStructure[]
  elections     Election[]

  @@map("academic_sessions")
}

model Student {
  id                 Int               @id @default(autoincrement())
  user_id            Int
  matric_no          String           @unique
  school_id          Int
  department_id      Int
  programme_id       Int
  current_level_id    Int
  session_id         Int
  admission_year     Int
  status             String           @default("active")
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  deleted_at         DateTime?
  user               User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  school             School           @relation(fields: [school_id], references: [id])
  department         Department      @relation(fields: [department_id], references: [id])
  programme          Programme       @relation(fields: [programme_id], references: [id])
  current_level      Level            @relation(fields: [current_level_id], references: [id])
  session            AcademicSession  @relation(fields: [session_id], references: [id])
  biodata            StudentBiodata?
  payments           Payment[]
  payment_complaints PaymentComplaint[]
  candidates         Candidate[]
  voter_eligibilities VoterEligibility[]
  welfare_requests   WelfareRequest[]
  support_tickets    SupportTicket[]

  @@map("students")
}

model StudentBiodata {
  id            Int      @id @default(autoincrement())
  student_id    Int      @unique
  first_name    String
  last_name     String
  middle_name   String?
  email         String   @unique
  phone_number  String
  house_address String
  parent_name   String
  parent_phone  String
  parent_email  String
  passport_path String?
  is_completed  Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  student       Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("student_biodata")
}

model FeeType {
  id           Int             @id @default(autoincrement())
  name         String
  description  String?         @db.Text
  created_at   DateTime        @default(now())
  updated_at   DateTime       @updatedAt
  fee_structures FeeStructure[]

  @@map("fee_types")
}

model FeeStructure {
  id            Int           @id @default(autoincrement())
  fee_type_id   Int
  programme_id  Int?
  level_id      Int?
  session_id    Int
  amount        Decimal       @db.Decimal(12, 2)
  is_mandatory  Boolean      @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  fee_type      FeeType       @relation(fields: [fee_type_id], references: [id], onDelete: Cascade)
  programme     Programme?   @relation(fields: [programme_id], references: [id], onDelete: Cascade)
  level         Level?       @relation(fields: [level_id], references: [id], onDelete: Cascade)
  session       AcademicSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  payments      Payment[]
  payment_complaints PaymentComplaint[]

  @@map("fee_structures")
}

model Payment {
  id                 Int               @id @default(autoincrement())
  student_id         Int
  fee_structure_id    Int
  amount             Decimal           @db.Decimal(12, 2)
  transaction_ref    String           @unique
  payment_gateway    String
  status             String           @default("pending")
  payment_date       DateTime?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  student            Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  fee_structure     FeeStructure     @relation(fields: [fee_structure_id], references: [id], onDelete: Cascade)
  receipts           Receipt[]

  @@map("payments")
}

model Receipt {
  id          Int      @id @default(autoincrement())
  payment_id  Int
  receipt_no  String  @unique
  issued_at   DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  payment     Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model PaymentComplaint {
  id                 Int          @id @default(autoincrement())
  student_id         Int
  fee_structure_id   Int
  transaction_ref    String
  amount             Decimal      @db.Decimal(15, 2)
  status             String       @default("pending") // pending, verified, rejected
  category           String?
  subject            String?      @db.Text
  admin_notes        String?      @db.Text
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  student            Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  fee_structure      FeeStructure @relation(fields: [fee_structure_id], references: [id], onDelete: Cascade)

  @@map("payment_complaints")
}

model Election {
  id                  Int                @id @default(autoincrement())
  name                String
  description         String?            @db.Text
  session_id          Int
  start_date          DateTime
  end_date            DateTime
  status              String            @default("Draft") // Draft, Scheduled, Open, Closed, Published
  accreditation_start DateTime?
  accreditation_end   DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  session             AcademicSession    @relation(fields: [session_id], references: [id])
  positions           ElectionPosition[]
  candidates         Candidate[]
  voter_eligibilities VoterEligibility[]
  votes               Vote[]
  audit_logs          ElectionAuditLog[]

  @@map("elections")
}

model ElectionPosition {
  id          Int        @id @default(autoincrement())
  election_id Int
  name        String
  description String?   @db.Text
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  election    Election   @relation(fields: [election_id], references: [id], onDelete: Cascade)
  candidates  Candidate[]
  votes       Vote[]

  @@map("election_positions")
}

model Candidate {
  id          Int              @id @default(autoincrement())
  election_id Int
  position_id Int
  student_id  Int
  photo_path  String?
  manifesto   String?          @db.Text
  biography   String?          @db.Text
  approval_status String       @default("pending") // pending, approved, rejected
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  election    Election        @relation(fields: [election_id], references: [id], onDelete: Cascade)
  position    ElectionPosition @relation(fields: [position_id], references: [id], onDelete: Cascade)
  student     Student         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  votes       Vote[]

  @@map("candidates")
}

model VoterEligibility {
  id          Int      @id @default(autoincrement())
  election_id Int
  student_id  Int
  is_eligible Boolean  @default(true)
  is_accredited Boolean @default(false)
  reason      String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  election    Election @relation(fields: [election_id], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([election_id, student_id])
  @@map("voter_eligibilities")
}

model Vote {
  id          Int              @id @default(autoincrement())
  election_id Int
  position_id Int
  candidate_id Int
  voter_hash  String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  election    Election         @relation(fields: [election_id], references: [id], onDelete: Cascade)
  position    ElectionPosition @relation(fields: [position_id], references: [id], onDelete: Cascade)
  candidate   Candidate        @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@unique([election_id, position_id, voter_hash], map: "unique_vote_per_position")
  @@index([voter_hash])
  @@map("votes")
}

model ElectionAuditLog {
  id          Int      @id @default(autoincrement())
  election_id Int
  action      String
  description String   @db.Text
  user_id     Int?
  ip_address  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  election    Election @relation(fields: [election_id], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [user_id], references: [id])

  @@map("election_audit_logs")
}

model Page {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String   @unique
  content          String?  @db.LongText
  meta_description String?  @db.Text
  is_published     Boolean  @default(true)
  order            Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("pages")
}

model NewsCategory {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  news       News[]

  @@map("news_categories")
}

model News {
  id            Int       @id @default(autoincrement())
  category_id   Int
  title         String
  slug          String    @unique
  content       String    @db.LongText
  is_published  Boolean   @default(true)
  published_at  DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  category      NewsCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  images        NewsImage[]

  @@map("news")
}

model NewsImage {
  id          Int      @id @default(autoincrement())
  news_id     Int
  image_path  String
  caption     String?
  created_at   DateTime @default(now())
  updated_at  DateTime @updatedAt
  news        News     @relation(fields: [news_id], references: [id], onDelete: Cascade)

  @@map("news_images")
}

model Achievement {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  date        DateTime @db.Date
  image       String?
  order       Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("achievements")
}

model Project {
  id              Int      @id @default(autoincrement())
  title           String
  description     String   @db.Text
  status          String
  completion_date DateTime? @db.Date
  image           String?
  order           Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("projects")
}

model Gallery {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?      @db.Text
  is_published Boolean      @default(true)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  images       GalleryImage[]

  @@map("galleries")
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  gallery_id  Int
  image_path  String
  caption     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  gallery     Gallery  @relation(fields: [gallery_id], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  event_date  DateTime
  location    String?
  image_path  String?
  is_published Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("events")
}

model Download {
  id          Int      @id @default(autoincrement())
  title       String
  file_path   String
  category    String?
  is_public   Boolean  @default(true)
  order       Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("downloads")
}

model HeroSlider {
  id                   Int      @id @default(autoincrement())
  image_path           String
  title                String?
  subtitle             String?
  cta_primary_text     String?
  cta_primary_url      String?
  cta_secondary_text   String?
  cta_secondary_url   String?
  overlay_color        String   @default("rgba(0,0,0,0.4)")
  sort_order           Int      @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@map("hero_sliders")
}

model WelfareCategory {
  id          Int               @id @default(autoincrement())
  name        String
  description String?          @db.Text
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  requests    WelfareRequest[]

  @@map("welfare_categories")
}

model WelfareRequest {
  id          Int               @id @default(autoincrement())
  student_id  Int
  category_id Int
  subject     String
  description String            @db.Text
  priority    String            @default("medium")
  status      String            @default("submitted")
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  student     Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  category    WelfareCategory   @relation(fields: [category_id], references: [id], onDelete: Cascade)
  attachments WelfareAttachment[]

  @@map("welfare_requests")
}

model WelfareAttachment {
  id               Int            @id @default(autoincrement())
  welfare_request_id Int
  file_path        String
  file_name        String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  welfare_request   WelfareRequest @relation(fields: [welfare_request_id], references: [id], onDelete: Cascade)

  @@map("welfare_attachments")
}

model SupportCategory {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  tickets     SupportTicket[]

  @@map("support_categories")
}

model SupportTicket {
  id            Int             @id @default(autoincrement())
  student_id    Int
  category_id   Int
  subject       String
  description   String          @db.Text
  ticket_number String          @unique
  status        String          @default("open")
  assigned_to   Int?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  student       Student         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  category      SupportCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  assigned_user User?           @relation("assigned_to", fields: [assigned_to], references: [id])
  messages      SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id               Int            @id @default(autoincrement())
  support_ticket_id Int
  user_id          Int
  message          String         @db.Text
  is_internal      Boolean        @default(false)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  support_ticket   SupportTicket  @relation(fields: [support_ticket_id], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("support_messages")
}
